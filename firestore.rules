rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // Contact form messages
    match /messages/{messageId} {

      // Anyone can submit a contact form
      allow create: if
        request.resource.data.name is string &&
        request.resource.data.email is string &&
        request.resource.data.subject is string &&
        request.resource.data.message is string &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.email.size() >= 5 &&
        request.resource.data.subject.size() >= 2 &&
        request.resource.data.message.size() >= 5;

      // Only logged-in admin can view messages
      allow read: if
        request.auth != null &&
        request.auth.token.email == "hashiremadi9000@gmail.com";

      // Only admin can update/delete messages
      allow update, delete: if
        request.auth != null &&
        request.auth.token.email == "hashiremadi9000@gmail.com";
    }

    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}